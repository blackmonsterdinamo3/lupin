[
    {
        "id": "67d776167ea5d",
        "title": "\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0430\u0439\u0442\u0430 lupin.su",
        "content": "\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0430\u0439\u0442\u0430 lupin.su \ud83c\udf1f\r\n\u0414\u043e\u0440\u043e\u0433\u0438\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438!\r\n\r\n\u041c\u044b \u0440\u0430\u0434\u044b \u0441\u043e\u043e\u0431\u0449\u0438\u0442\u044c \u0432\u0430\u043c, \u0447\u0442\u043e \u043d\u0430\u0448 \u0441\u0430\u0439\u0442 lupin.su \u043e\u0431\u043d\u043e\u0432\u0438\u043b\u0441\u044f! \ud83c\udf89 \u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u0432\u0430\u0448\u0435 \u0442\u0435\u0440\u043f\u0435\u043d\u0438\u0435 \u0438 \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u0435. \ud83d\ude0a\r\n\r\n\u0412 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u043c\u044b \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u043c \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043d\u043e\u0432\u044b\u0435 \u0442\u0430\u0439\u0442\u043b\u044b \u0438 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u0430\u043d\u0438\u043c\u0435, \u0442\u0430\u043a \u0447\u0442\u043e \u0441\u043b\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438!\r\n\r\n\u0412\u0430\u0448\u0438 \u043e\u0442\u0437\u044b\u0432\u044b \u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u043e\u0447\u0435\u043d\u044c \u0432\u0430\u0436\u043d\u044b \u0434\u043b\u044f \u043d\u0430\u0441. \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0438\u043c \u0432\u0430\u0441 \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u0432\u044b \u0441 \u043d\u0430\u043c\u0438! \u2764\ufe0f\r\n\r\n\u0421 \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435\u043c,\r\n\r\n\u041a\u043e\u043c\u0430\u043d\u0434\u0430 lupin.su",
        "image": "uploads\/news\/67d7761586043_image.jpg",
        "video": null,
        "date": "2025-03-17 01:08:38"
    },
    {
        "id": "67da18291f85b",
        "title": "\ud83c\udf89 \u0412\u043d\u0438\u043c\u0430\u043d\u0438\u0435, \u0434\u043e\u0440\u043e\u0433\u0438\u0435 \u043f\u043e\u0434\u043f\u0438\u0441\u0447\u0438\u043a\u0438! \ud83c\udf89",
        "content": "\u041c\u044b \u0440\u0430\u0434\u044b \u0441\u043e\u043e\u0431\u0449\u0438\u0442\u044c, \u0447\u0442\u043e \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0438 \u0432\u0441\u0435 \u0430\u043d\u0438\u043c\u0435 \u0441 \u0441\u0442\u0430\u0440\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u043d\u0430\u0448\u0435\u0433\u043e \u0441\u0430\u0439\u0442\u0430! \u0422\u0435\u043f\u0435\u0440\u044c \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u0442\u044c\u0441\u044f \u043b\u044e\u0431\u0438\u043c\u044b\u043c\u0438 \u0441\u0435\u0440\u0438\u044f\u043c\u0438 \u043d\u0430 lupin.su \ud83d\udc96.\r\n\r\n\ud83d\udcfa \u0412\u0435\u0434\u0435\u0442\u0441\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430\u0434 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u043e\u0439 \u043d\u043e\u0432\u044b\u0445 \u0441\u0435\u0440\u0438\u0439 \u0438 \u0430\u043d\u0438\u043c\u0435! \u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u0432\u0430\u0448\u0435 \u0442\u0435\u0440\u043f\u0435\u043d\u0438\u0435 \u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443. \u041e\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435\u0441\u044c \u0441 \u043d\u0430\u043c\u0438, \u0432\u043f\u0435\u0440\u0435\u0434\u0438 \u043c\u043d\u043e\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e\u0433\u043e! \ud83d\ude80\r\n\r\n\u0421 \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435\u043c,\r\n\r\n\u041a\u043e\u043c\u0430\u043d\u0434\u0430 lupin.su",
        "image": "uploads\/news\/67da182849455_\u043d\u043e\u0432\u043e\u0441\u0442\u044c 19.03.2025.png",
        "video": null,
        "date": "2025-03-19 01:04:41"
    },
    {
        "id": "67db939281167",
        "title": "\u041d\u043e\u0432\u0430\u044f \u0441\u0435\u0440\u0438\u044f \"\u041f\u043e\u0434\u043d\u044f\u0442\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u043a\u0443 2: \u0412\u043e\u0441\u0441\u0442\u0430\u043d\u044c\u0442\u0435 \u0438\u0437 \u0442\u0435\u043d\u0438\" \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 Lupin.su",
        "content": "\u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0430 \u043d\u043e\u0432\u0430\u044f \u0441\u0435\u0440\u0438\u044f \"\u041f\u043e\u0434\u043d\u044f\u0442\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u043a\u0443 2: \u0412\u043e\u0441\u0441\u0442\u0430\u043d\u044c\u0442\u0435 \u0438\u0437 \u0442\u0435\u043d\u0438\"! \ud83c\udfac \u0422\u0435\u043f\u0435\u0440\u044c \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e \u0441 \u043e\u0437\u0432\u0443\u0447\u043a\u043e\u0439 \u0438 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0430\u043c\u0438! \ud83d\udcdd\r\n\r\n\u041d\u043e\u0432\u044b\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b: \u0442\u0435\u043f\u0435\u0440\u044c \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u0442\u044c\u0441\u044f \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u043e\u043c \u0441 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0430\u043c\u0438, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u043a\u043e\u043d\u0442\u0435\u043d\u0442 \u0435\u0449\u0435 \u0431\u043e\u043b\u0435\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u043c! \ud83c\udf1f\r\n\r\n\u0414\u043b\u044f \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0430 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442\u0435 \u043f\u043e \u0441\u0441\u044b\u043b\u043a\u0435: Lupin.su - \u042d\u043f\u0438\u0437\u043e\u0434 11\r\n\r\n\u041d\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0435! \ud83d\ude0a",
        "image": "uploads\/news\/67db9391802f9_\u0421\u043d\u0438\u043c\u043e\u043a \u044d\u043a\u0440\u0430\u043d\u0430 2025-03-20 070300.png",
        "video": null,
        "date": "2025-03-20 04:03:30"
    },
    {
        "id": "67dc89be04030",
        "title": "\u0423\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 Lupin.su",
        "content": "\u0423\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u043f\u043e\u0438\u0441\u043a\u0430 \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 Lupin.su \ud83c\udf89\r\n\u0414\u043e\u0440\u043e\u0433\u0438\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438! \u041c\u044b \u0440\u0430\u0434\u044b \u0441\u043e\u043e\u0431\u0449\u0438\u0442\u044c \u043e \u043d\u043e\u0432\u044b\u0445 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044f\u0445 \u0432 \u043f\u043e\u0438\u0441\u043a\u0435 \u0430\u043d\u0438\u043c\u0435 \u043d\u0430 \u043d\u0430\u0448\u0435\u043c \u0441\u0430\u0439\u0442\u0435! \u0422\u0435\u043f\u0435\u0440\u044c \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435:\r\n\r\n\ud83d\udcc5 \u0421\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u0434\u0430\u0442\u0435 \u0432\u044b\u0445\u043e\u0434\u0430 \u0430\u043d\u0438\u043c\u0435\r\n\u23f3 \u0421\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u0434\u0430\u0442\u0435 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u043d\u0430 \u0441\u0430\u0439\u0442 \r\n\u2b50 \u0421\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0443 (\u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435 \u0438 \u0443\u0431\u044b\u0432\u0430\u043d\u0438\u0435)\r\n\ud83c\udfad \u0424\u0438\u043b\u044c\u0442\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u0436\u0430\u043d\u0440\u0430\u043c\r\n\u042d\u0442\u0438 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u0441\u0434\u0435\u043b\u0430\u044e\u0442 \u0432\u0430\u0448 \u043f\u043e\u0438\u0441\u043a \u0431\u043e\u043b\u0435\u0435 \u0443\u0434\u043e\u0431\u043d\u044b\u043c \u0438 \u0431\u044b\u0441\u0442\u0440\u044b\u043c! \u041d\u0435 \u0443\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043d\u0430\u0439\u0442\u0438 \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u043e \u0430\u043d\u0438\u043c\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u0430\u043c \u043d\u0443\u0436\u043d\u043e!\r\n\r\n#\u0410\u043d\u0438\u043c\u0435 #\u0421\u0443\u0431\u0442\u0438\u0442\u0440\u044b #LupinSu #\u041e\u0437\u0432\u0443\u0447\u043a\u0430 #lupinsu #\u0430\u043d\u0438\u043c\u0435 #\u043d\u043e\u0432\u043e\u0441\u0442\u0438 #\u0430\u043d\u0438\u043c\u0435\u043e\u043d\u043b\u0430\u0439\u043d\r\n\r\n\u2728 \u0421\u043f\u0430\u0441\u0438\u0431\u043e, \u0447\u0442\u043e \u043e\u0441\u0442\u0430\u0435\u0442\u0435\u0441\u044c \u0441 \u043d\u0430\u043c\u0438!",
        "image": "uploads\/news\/67dc89bce52fc_image (2).jpg",
        "video": null,
        "date": "2025-03-20 21:33:50"
    },
    {
        "id": "67dcb783cc7b6",
        "title": "\u0417\u0430\u043c\u0435\u043d\u0430 \u0434\u043b\u044f \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u0435\u0439 \u0437\u0440\u0435\u043b\u0438\u0449\u043d\u044b\u0445 \u0431\u043e\u0451\u0432",
        "content": "\u0421 \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u0435\u043c \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u0441\u0435\u0437\u043e\u043d\u0430 \"\u041f\u043e\u0434\u043d\u044f\u0442\u0438\u044f \u0443\u0440\u043e\u0432\u043d\u044f\" \u0444\u0430\u043d\u0430\u0442\u044b \u0438\u0449\u0443\u0442 \u043d\u043e\u0432\u044b\u0435 \u0430\u043d\u0438\u043c\u0435, \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b\u0435 \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u0438\u0442\u044c \u0438\u0445 \u0436\u0430\u0436\u0434\u0443 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u044b\u0445 \u0441\u0440\u0430\u0436\u0435\u043d\u0438\u0439. \u041a \u0441\u0447\u0430\u0441\u0442\u044c\u044e, \u0435\u0441\u0442\u044c \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0445 \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432.\r\n\r\n\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0438 \u0434\u043b\u044f \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0430\r\n\"\u0412\u043e\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0433\u0435\u0440\u043e\u044f \u0449\u0438\u0442\u0430 (\u0441\u043a\u043e\u0440\u043e \u043d\u0430 lupin.su)\" - \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043e \u0433\u0435\u0440\u043e\u0435, \u0441\u043f\u0430\u0441\u0430\u044e\u0449\u0435\u043c \u043c\u0438\u0440 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0449\u0438\u0442\u0430.\r\n\"\u041c\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0431\u0438\u0442\u0432\u0430\" - \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u044b\u0435 \u0441\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0441 \u043c\u0430\u0433\u0438\u0435\u0439. https:\/\/lupin.su\/series.php?folder=Jujutsukaisen\r\n\"\u041d\u0430\u0440\u0443\u0442\u043e\" - \u043a\u043b\u0430\u0441\u0441\u0438\u043a\u0430, \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u044e\u0449\u0430\u044f \u043d\u043e\u0432\u044b\u0435 \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u044f. https:\/\/lupin.su\/series.php?folder=Naruto\r\n\"\u041d\u0438\u043d\u0434\u0437\u044f \u041a\u0430\u043c\u0443\u0438 (\u0441\u043a\u043e\u0440\u043e \u043d\u0430 lupin.su)\" - \u0431\u0440\u0443\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043c\u0435\u0441\u0442\u0438 \u0441 \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0438\u043c\u0438 \u043c\u043e\u043c\u0435\u043d\u0442\u0430\u043c\u0438.\r\n\u0421\u043b\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438 \u043d\u0430 \u043d\u0430\u0448\u0435\u043c \u0441\u0430\u0439\u0442\u0435 lupin.su, \u0433\u0434\u0435 \u0441\u043a\u043e\u0440\u043e \u043f\u043e\u044f\u0432\u044f\u0442\u0441\u044f \u043d\u043e\u0432\u044b\u0435 \u0430\u043d\u0438\u043c\u0435!\r\n\r\n\u0425\u0435\u0448\u0442\u0435\u0433\u0438\r\n#\u0430\u043d\u0438\u043c\u0435 #\u0437\u0440\u0435\u043b\u0438\u0449\u043d\u044b\u0435\u0431\u043e\u0438 #lupin #\u043d\u043e\u0432\u0438\u043d\u043a\u0438\u0430\u043d\u0438\u043c\u0435 #\u043f\u043e\u0434\u043d\u044f\u0442\u0438\u0435\u0443\u0440\u043e\u0432\u043d\u044f\r\n\r\n\u0416\u0434\u0435\u043c \u0432\u0430\u0448\u0438\u0445 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0435\u0432 \u0438 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0439! \ud83d\ude0a\u2728\r\n\r\n\u0421 \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435\u043c, \u043a\u043e\u043c\u0430\u043d\u0434\u0430 lupin.su \ud83d\udc96",
        "image": "uploads\/news\/67dcb782e9ae2_solo.jpg",
